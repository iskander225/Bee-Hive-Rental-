# Copy this file to .env and enter the password of the NEW PostgreSQL 17 server.
# Never publish .env or send your database password in a chat.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=beehive_api_db
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_YOUR_POSTGRESQL_17_PASSWORD

# Comma-separated frontend origins; change if teammates use another URL.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
